# Server Configuration
PORT=3005
NODE_ENV=development

# PAPI Configuration
PAPI_CHAIN=polkadot
PAPI_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_MAX=100

# Cache Configuration
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false