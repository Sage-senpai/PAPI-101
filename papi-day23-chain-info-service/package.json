{
  "name": "chain-info-api-service",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend service for Polkadot chain data",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --exec tsx src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t chain-info-api .",
    "docker:run": "docker run -p 3005:3005 chain-info-api"
  },
  "keywords": [
    "polkadot",
    "blockchain",
    "api",
    "papi",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@polkadot-api/descriptors": "^0.0.1",
    "@polkadot-api/substrate-bindings": "^0.9.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "node-cache": "^5.1.2",
    "polkadot-api": "^1.7.11",
    "prom-client": "^15.1.3",
    "smoldot": "^2.0.35",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/node-cache": "^4.2.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
