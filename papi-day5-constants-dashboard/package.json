{
  "name": "chain-constants-dashboard",
  "version": "1.0.0",
  "description": "Day 5 PAPI 30 Days Challenge - Live Chain Constants Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf node_modules dist",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "setup": "npx papi add dot -n polkadot && npx papi"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "file:.papi\\descriptors",
    "polkadot-api": "^1.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.4.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "keywords": [
    "polkadot",
    "papi",
    "constants",
    "blockchain",
    "typescript",
    "dashboard",
    "web3"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}