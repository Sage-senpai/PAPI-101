{
  "name": "papi-the-vault",
  "version": "1.0.0",
  "description": "Secure private key signing service for Polkadot using PAPI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "papi-vault": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/index.ts demo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "generate-key": "tsx src/index.ts generate",
    "list-keys": "tsx src/index.ts list",
    "sign-tx": "tsx src/index.ts sign",
    "audit-logs": "tsx src/index.ts audit",
    "security-check": "tsx src/index.ts security"
  },
  "keywords": [
    "polkadot",
    "papi",
    "signing",
    "cryptography",
    "security",
    "blockchain",
    "web3"
  ],
  "author": "PAPI30Days Campaign",
  "license": "MIT",
  "dependencies": {
    "@polkadot/api": "^10.11.1",
    "@polkadot/keyring": "^12.6.2",
    "@polkadot/util": "^12.6.2",
    "@polkadot/util-crypto": "^12.6.2",
    "polkadot-api": "^0.13.0",
    "@polkadot-api/descriptors": "^0.13.0",
    "@noble/ed25519": "^2.0.0",
    "@noble/secp256k1": "^2.0.0",
    "chalk": "4.1.2",
    "ora": "6.3.0",
    "boxen": "7.1.1",
    "yargs": "17.7.2",
    "inquirer": "9.2.12",
    "dotenv": "^16.3.1",
    "argon2": "^0.31.1",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/jest": "^29.5.6",
    "@types/yargs": "^17.0.24",
    "@types/inquirer": "^9.0.7",
    "@types/bcrypt": "^5.0.1",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^3.14.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polkadot-api/papi30days-day12.git"
  },
  "bugs": {
    "url": "https://github.com/polkadot-api/papi30days-day12/issues"
  },
  "homepage": "https://github.com/polkadot-api/papi30days-day12#readme"
}