# Security Configuration
NODE_ENV=development
LOG_LEVEL=info

# Key Management
KEY_STORAGE_PATH=./secure-keys
KEY_ENCRYPTION_SECRET=change-this-in-production
KEY_ROTATION_DAYS=30

# Network Configuration
DEFAULT_NETWORK=polkadot
POLKADOT_RPC_URL=wss://rpc.polkadot.io
KUSAMA_RPC_URL=wss://kusama-rpc.polkadot.io
WESTEND_RPC_URL=wss://westend-rpc.polkadot.io

# Security Settings
MAX_SIGNING_ATTEMPTS=3
SESSION_TIMEOUT_MINUTES=15
REQUIRE_2FA=false

# Audit Logging
AUDIT_LOG_PATH=./audit-logs
ENABLE_TAMPER_PROOF=true# Network Configuration
NETWORK=westend
WS_ENDPOINT=wss://westend-rpc.polkadot.io

# Security (DO NOT commit real keys)
# These are example values for testing only
TEST_MNEMONIC=bottom drive obey lake curtain smoke basket hold race lonely fit walk
TEST_SEED=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Logging
LOG_LEVEL=info
ENABLE_AUDIT=true